GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Opsional - fallback ke Claude (Haiku 4.5) kalau Gemini API lagi sibuk/limit (503/429/5xx).
# Kosongin aja kalau nggak mau pakai fallback, aplikasi tetap jalan normal cuma tanpa fallback.
ANTHROPIC_API_KEY=

# Dari @BotFather di Telegram - dua bot terpisah, satu buat spending satu buat kalori
TELEGRAM_BOT_TOKEN_SPENDING=
TELEGRAM_BOT_TOKEN_CALORIE=

PORT=3000

# User yang boleh pakai bot & dashboard web dikelola di tabel Supabase "app_users"
# (username, password, phone/chat id) - bukan dari .env.

# Wajib diisi, buat nge-sign session cookie login dashboard web
SESSION_SECRET=
